{
  "name": "mermaid-mcp-app",
  "version": "0.1.0",
  "description": "MCP App that renders Mermaid diagrams as interactive UI in Claude, ChatGPT, VS Code and other MCP clients",
  "type": "module",
  "main": "dist/server/index.js",
  "bin": {
    "mermaid-mcp-app": "dist/server/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:view": "vite build",
    "build:server": "tsc",
    "build": "npm run build:view && npm run build:server",
    "dev": "concurrently \"vite build --watch\" \"tsc --watch\"",
    "start": "node dist/server/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "mermaid",
    "diagram",
    "mcp-app",
    "visualization"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.2.2",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "lucide": "^0.577.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "express": "^5.2.1",
    "mermaid": "^11.13.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vite-plugin-singlefile": "^2.3.2"
  }
}
